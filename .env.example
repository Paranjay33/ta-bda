# HinglishSense runtime configuration. Copy to .env and adjust.
# NEVER put real secrets in this file or in version control.

APP_ENV=development                 # development | production (production REQUIRES AUTH_REQUIRED=true)
API_PORT=8000
LOG_LEVEL=INFO

# Database: SQLite for a single-user/local demo; PostgreSQL for hosted/multi-replica.
DATABASE_URL=sqlite:///./data/hinglishsense.db
# DATABASE_URL=postgresql+psycopg2://hinglishsense:<password>@db-host:5432/hinglishsense

# Browser origins allowed to call the API (same-origin frontend needs none).
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Access control. Local demo: false. Any public deployment: true + a strong key.
AUTH_REQUIRED=false
API_KEY=
RATE_LIMIT_PER_MINUTE=120

# Privacy: raw user text is NOT stored unless this is true (then only normalized text).
ALLOW_HISTORY_STORAGE=false

# Auto policy (backend-controlled; fallbacks are always reported in the response).
PREFERRED_MODEL=e4
AUTO_FALLBACK=e3,e2,e1

# Limits
MAX_TEXT_CHARS=500
MAX_BATCH_ROWS=500
SYNC_BATCH_MAX_ROWS=100
MAX_UPLOAD_MB=10

# Model runtime
TRANSFORMER_DEVICE=auto             # auto | cuda | cpu
LOAD_MODELS_ON_STARTUP=true         # warm E3/E4 at start-up (readiness waits for it)
SPARK_SERVICE_URL=http://127.0.0.1:8090
HF_HUB_OFFLINE=1                    # serving reads fine-tuned checkpoints from ./artifacts only

# Docker build: CPU torch by default; for NVIDIA GPUs use the CUDA wheel index.
TORCH_INDEX=https://download.pytorch.org/whl/cpu
# TORCH_INDEX=https://download.pytorch.org/whl/cu121
